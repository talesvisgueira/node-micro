{
  "name": "node-pnpm",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start:gateway": "pnpm --filter gateway start",
    "start:users": "pnpm --filter users start",
    "start:payments": "pnpm --filter payments start",
    "start:products": "pnpm --filter products start",
    "start:checkouts": "pnpm --filter checkouts start",
    "start:loggers": "pnpm --filter loggers start",
    "start:web": "pnpm --filter web start",
    "start:filial": "pnpm --filter filial start",
    "start": "pnpm run start:gateway & pnpm run start:users & pnpm run start:payments & pnpm run start:products & pnpm run start:checkouts & pnpm run start:loggers & pnpm run start:web & pnpm run start:filial ",
    "start:dev": "pnpm pnpm run start:gateway & pnpm run start:users & pnpm run start:loggers",
    "stop": "ps aux | grep -i node | awk '{print $2}' | xargs  kill -9",
    "build": "pnpm recursive run build",
    "test": "pnpm recursive run test"
  },
